# DeepSeek official provider credential. Never commit the real key.
DEEPSEEK_API_KEY=

# Optional route overrides used by src/index.ts.
DSH_LITE_PROVIDER=deepseek-official
DSH_LITE_MODEL=deepseek-v4-flash

# Terminal Agent trace: 1/true/on enables; 0/false/off or unset disables. Restart after changing.
DSH_LITE_TRACE=0
